        "num_streams": 32,
        "samplerate": 102400000.0,
        "size": 4096,
        "autostreams": [
          {
            "start": 0,
            "stop": 31
          }
        ]
      }
    },
    {
      "name": "out",
      "type": "SQLiteStoreOutput",
      "settings": {
        "storename": "SQLite4096.db",
